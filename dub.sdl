name "config-key-sanitation"
description "Classify, match, and alert on CLI config keys — active, deprecated, expired, unknown (never drop detection)"
version "0.1.0"
authors "OpenShellOrg"
copyright "Copyright © 2026, OpenShellOrg"
homepage "https://github.com/openshellorg/config-key-sanitation"
license "MIT"

targetType "library"
targetName "config-key-sanitation"

configuration "library" {
	targetType "library"
	excludedSourceFiles "source/demo/*"
}

configuration "demo" {
	targetType "executable"
	targetName "cks-demo"
	mainSourceFile "source/demo/app.d"
	stringImportPaths "fixtures"
}
